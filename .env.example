# Application settings
FERNET_KEY=replace-with-a-generated-key

# Development attachment storage
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_LOCAL_DIR=uploads/tickets

# Production S3-compatible attachment storage
# ATTACHMENT_STORAGE_BACKEND=s3
# ATTACHMENT_S3_BUCKET=ticket-attachments
# ATTACHMENT_S3_PREFIX=production
# ATTACHMENT_S3_REGION=us-east-1
# ATTACHMENT_S3_ENDPOINT_URL=https://s3.example.com
# ATTACHMENT_S3_ADDRESSING_STYLE=path
# ATTACHMENT_S3_SSE=AES256

# Credentials are normally supplied by an IAM role or workload identity.
# For development-only S3-compatible services, these can be set explicitly:
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
